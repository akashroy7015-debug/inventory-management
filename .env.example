# PostgreSQL connection string (Neon, Supabase, Railway, RDS or self-hosted)
DATABASE_URL="postgresql://user:password@localhost:5432/stockhub"
# Long random string used to sign login sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Protects /api/cron/sync, which pulls marketplace orders and pushes stock. Generate with: openssl rand -hex 24
CRON_SECRET=""
# Optional: separate key for encrypting marketplace credentials (defaults to AUTH_SECRET). Never change it once set.
ENCRYPTION_KEY=""
